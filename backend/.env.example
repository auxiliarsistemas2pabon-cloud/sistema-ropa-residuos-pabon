# Copiar a .env y ajustar. .env nunca se versiona (ver .gitignore).

DJANGO_SETTINGS_MODULE=config.settings.local
DJANGO_SECRET_KEY=cambia-esta-clave-en-cada-entorno
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# API REST (/api/): solo hace falta si el frontend se sirve desde otro
# origen (p. ej. el dev server de Vite en otro puerto). Vacío = deshabilitado.
# Una entrada por cada dirección desde la que se abrirá la aplicación, p. ej.
# http://localhost:5173,http://127.0.0.1:5173,http://192.168.1.20:5173
# (para abrirla desde otro computador o celular, agregar su IP y sumarla también
# a DJANGO_ALLOWED_HOSTS).
CORS_ALLOWED_ORIGINS=
CSRF_TRUSTED_ORIGINS=

POSTGRES_DB=clinica_pabon
POSTGRES_USER=clinica_pabon
POSTGRES_PASSWORD=clinica_pabon
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
