# Copiar a .env y ajustar. .env nunca se versiona (ver .gitignore).

DJANGO_SETTINGS_MODULE=config.settings.local
DJANGO_SECRET_KEY=cambia-esta-clave-en-cada-entorno
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# API REST (/api/): solo hace falta si el frontend se sirve desde otro
# origen (p. ej. el dev server de Vite en otro puerto). Vacío = deshabilitado.
# Una entrada por cada dirección desde la que se abrirá la aplicación, p. ej.
# http://localhost:5173,http://127.0.0.1:5173,http://192.168.1.20:5173
# (para abrirla desde otro computador o celular, agregar su IP y sumarla también
# a DJANGO_ALLOWED_HOSTS).
CORS_ALLOWED_ORIGINS=
CSRF_TRUSTED_ORIGINS=

# Respaldos (protocolo de seguridad, A5; ver DESPLIEGUE.md, sección 4).
# Vacíos = desactivado (desarrollo); en producción `check --deploy` avisa.
RESPALDO_GPG_DESTINATARIO=
RESPALDO_GPG_LLAVE_PUBLICA=
RESPALDO_COPIA_EXTERNA_HOST=
RESPALDO_COPIA_EXTERNA_DIR=
RESPALDO_AVISO_CORREOS=
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=

# Redes desde las que se abre /admin/ (A6), separadas por espacio. Vacío =
# las redes privadas. Ej.: 192.168.10.0/24 10.20.0.0/16
ADMIN_REDES_PERMITIDAS=

POSTGRES_DB=clinica_pabon
POSTGRES_USER=clinica_pabon
POSTGRES_PASSWORD=clinica_pabon
POSTGRES_HOST=localhost
POSTGRES_PORT=5434
